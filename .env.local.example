# =============================================================================
# KI Translator KMU — Environment Variables
# =============================================================================
# Copy this file to .env.local and fill in your values.
# NEVER commit .env.local — it is gitignored.
#
# For Docker: docker compose reads .env.local automatically via env_file.
# For Vercel: set these in the project's Environment Variables dashboard.
# =============================================================================

# --- Supabase ---
# Found in: Supabase Dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-ref.supabase.co
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-publishable-key-here   # NOT the anon key
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here             # server-side only

# --- AI Provider ---
# Controls which LLM backend is used at runtime.
# Options: 'ollama' (local, no API key) | 'anthropic' (production)
#
# Which run command pairs with which provider:
#   AI_PROVIDER=ollama     → pnpm dev            (native Ollama on the host)
#                          → pnpm docker:up      (containerised Ollama, zero setup)
#   AI_PROVIDER=anthropic  → pnpm docker:up:prod (needs ANTHROPIC_API_KEY below)
AI_PROVIDER=ollama

# Anthropic — required when AI_PROVIDER=anthropic
ANTHROPIC_API_KEY=sk-ant-...

# Ollama base URL — leave this COMMENTED OUT.
#   • `pnpm dev`        → provider.ts falls back to http://localhost:11434
#                         (your native Ollama).
#   • `pnpm docker:up`  → docker-compose.yml injects http://ollama:11434
#                         (the Ollama container) and overrides any value here.
# Only set it manually if you run against a remote/external Ollama host.
# OLLAMA_BASE_URL=http://localhost:11434

# --- App ---
PORT=3000
