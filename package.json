{
  "name": "ki-translator-kmu",
  "version": "0.1.0",
  "private": true,
  "packageManager": "pnpm@11.5.0",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "ci:test": "pnpm lint && pnpm format:check && pnpm typecheck && pnpm test",
    "demo": "node scripts/demo-setup.mjs && next dev",
    "demo:down": "node scripts/demo-down.mjs",
    "docker:build": "docker compose --env-file .env.local build",
    "docker:up": "node scripts/ollama.mjs && AI_PROVIDER=ollama docker compose --env-file .env.local --profile ollama up -d",
    "docker:up:prod": "AI_PROVIDER=mistral docker compose --env-file .env.local up -d",
    "docker:down": "docker compose down",
    "docker:restart": "node scripts/ollama.mjs && AI_PROVIDER=ollama docker compose --env-file .env.local --profile ollama up -d --build",
    "docker:logs": "docker compose logs -f",
    "docker:ps": "docker compose ps"
  },
  "dependencies": {
    "@ai-sdk/mistral": "^4.0.14",
    "@ai-sdk/react": "^4.0.40",
    "@supabase/ssr": "^0.10.3",
    "@supabase/supabase-js": "^2.106.2",
    "ai": "^7.0.37",
    "ai-sdk-ollama": "^4.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "jspdf": "^4.2.1",
    "lucide-react": "^1.17.0",
    "next": "16.2.6",
    "next-themes": "^0.4.6",
    "radix-ui": "^1.4.3",
    "react": "19.2.4",
    "react-dom": "19.2.4",
    "shadcn": "^4.10.0",
    "sonner": "^2.0.7",
    "tailwind-merge": "^3.6.0",
    "tw-animate-css": "^1.4.0",
    "zod": "^4.4.3"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@testing-library/react": "^16.3.3",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.2.6",
    "eslint-config-prettier": "^10.1.8",
    "eslint-plugin-simple-import-sort": "^13.0.0",
    "jsdom": "^30.0.1",
    "prettier": "^3.8.3",
    "supabase": "^2.111.0",
    "tailwindcss": "^4",
    "typescript": "^5",
    "vitest": "^4.1.10"
  }
}
